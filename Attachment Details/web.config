<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!-- Serve index.html as the default document -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!--
      URL Rewrite Rule
      ─────────────────────────────────────────────────────────────
      When IIS receives a request like:
          /apps4x/AttachmentDetails/45396
      and there is no real file or folder named "45396",
      rewrite the request to index.html so the JavaScript can
      read the record ID from window.location.pathname.
      ─────────────────────────────────────────────────────────────
      REQUIREMENT: IIS URL Rewrite module must be installed.
      Download: https://www.iis.net/downloads/microsoft/url-rewrite
    -->
    <rewrite>
      <rules>
        <rule name="SPA – serve index.html for unknown paths" stopProcessing="true">
          <!--
            Match everything EXCEPT known static file extensions.
            This prevents rewriting requests for .css, .js, .svg etc.
          -->
          <match url="^(?!.*\.(css|js|ico|png|jpg|jpeg|gif|svg|woff|woff2|ttf|eot|map|json)$).*$" />
          <conditions logicalGrouping="MatchAll">
            <!-- Do not rewrite if the path is a real file -->
            <add input="{REQUEST_FILENAME}" matchType="IsFile"      negate="true" />
            <!-- Do not rewrite if the path is a real directory -->
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <!-- Rewrite to index.html in the same folder -->
          <action type="Rewrite" url="index.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- Suppress IIS detailed error pages so our own UI shows -->
    <httpErrors existingResponse="PassThrough" />

  </system.webServer>
</configuration>
